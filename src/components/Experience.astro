---
import data from '../data/content.json';
import experience from '../data/experience.json';
const {page,lang}=Astro.props, x=experience[lang],u=data.ui[lang],brand=data.brand;
const home=page==='home',corp=brand==='corporate',personal=brand==='personal',creative=brand==='creative';
const local=(s='')=>`${lang==='en'?'':'/'+lang}/${s?s+'/':''}`;
---
{(home||page==='principles'||page==='solutions')&&x.layers&&<section class="section explorer-section reveal" id="explore"><div class="section-heading"><div><div class="eyebrow">{u.explore}</div><h2>{x.intro[0]}</h2></div><p>{x.intro[1]}</p></div><div class="explorer glass" data-switcher><div class="choice-list" aria-label={u.select}>{x.layers.map((r,i)=><button data-choice={i} aria-controls={`layer-${i}`}><span class="mono">0{i+1}</span>{r[0]}<span aria-hidden="true">↗</span></button>)}</div><div class="choice-panels">{x.layers.map((r,i)=><article data-panel={i} id={`layer-${i}`}><div class="panel-index" aria-hidden="true">0{i+1}</div><h3>{r[1]}</h3><p>{r[2]}</p><span class="technical-tag mono">{r[3]}</span></article>)}</div></div></section>}
{(home||page==='solutions')&&x.details&&<section class="section reveal service-section"><div class="section-heading"><div><div class="eyebrow">{u.deliver}</div><h2>{u.services}</h2></div><p>{data.pages[lang].home.sectionText}</p></div><div class="service-accordions">{x.details.map((r,i)=><details class="service-detail" open={i===0}><summary><span class="mono">0{i+1}</span><h3>{r[0]}</h3><span class="plus" aria-hidden="true">+</span></summary><div class="service-expanded"><p>{r[1]}</p><ul>{r[2].map(t=><li>{t}</li>)}</ul></div></details>)}</div></section>}
{(home||page==='projects'||page==='solutions')&&x.scenarios&&<section class="section reveal"><div class="section-heading"><div><div class="eyebrow">{corp?u.scenarios:u.work}</div><h2>{corp?data.pages[lang].home.storyHeading.replaceAll('<br/>',' '):data.pages[lang].home.sectionHeading.replaceAll('<br/>',' ')}</h2></div><p>{corp?u.scenarioNote:data.pages[lang].home.sectionText}</p></div><div class="direction-grid">{x.scenarios.map((r,i)=><article class="direction-card"><div class="card-icon mono" aria-hidden="true">{['↗','⌁','◉'][i]}</div><div class="eyebrow">{r[0]}</div><h3>{r[1]}</h3><p>{r[2]}</p><div class="card-outcome"><span class="mono">{u.outputs}</span><p>{r[3]}</p></div>{personal&&<a class="text-link" href={i===0?local('notes'):i===1?'https://duncansystem.com'+local():'https://dienvienhientrenbien.com'+local()} target={i>0?'_blank':undefined} rel={i>0?'noopener noreferrer':undefined}>{u.connect} ↗</a>}{corp&&<a class="text-link" href={local('contact')}>{u.talk} ↗</a>}</article>)}</div></section>}
{(home||page==='about'||page==='principles')&&x.process&&<section class="section process-section reveal"><div class="eyebrow">{u.process}</div><ol class="process-grid">{x.process.map((r,i)=><li><span class="process-number mono">0{i+1}</span><h3>{r[0]}</h3><p>{r[1]}</p></li>)}</ol></section>}
{(home||page==='notes')&&x.notes&&<section class="section reveal"><div class="section-heading"><div><div class="eyebrow">{u.notes}</div><h2 set:html={data.pages[lang].notes.heading}/></div><p>{data.pages[lang].notes.lead}</p></div><div class:list={[home?'note-grid':'long-notes']}>{x.notes.map(r=><article class="note" id={r[0]}><span class="mono">{r[2]}</span><h3>{r[1]}</h3><p>{r[3]}</p>{home?<a class="text-link" href={local('notes')+'#'+r[0]}>{u.read} ↗</a>:<><p>{r[4]}</p><ul>{r[5].map(t=><li>{t}</li>)}</ul></>}</article>)}</div></section>}
{(home||page==='contact'||page==='solutions')&&x.faqs&&<section class="section faq-section reveal"><div><div class="eyebrow">FAQ</div><h2>{u.faq}</h2></div><div>{x.faqs.map(r=><details class="faq"><summary>{r[0]}<span aria-hidden="true">+</span></summary><p>{r[1]}</p></details>)}</div></section>}
{creative&&(home||page==='music')&&<section class="section music-section reveal" id="listen"><div class="section-heading"><div><div class="eyebrow">01 / {u.music}</div><h2>{x.music[0]}</h2></div><p>{x.music[1]}</p></div><div class="listening-room glass"><div><span class="mono">DIỄN VIÊN HIỆN TRÊN BIỂN</span><h3>{x.music[2]}</h3><p>{x.music[3]}</p><a class="button primary" href="https://open.spotify.com/artist/5SDr2lA0fFux0k4qYZYbAT" target="_blank" rel="noopener noreferrer">{x.listen} ↗</a></div><div class="spotify-slot" data-spotify><div class="record-art" aria-hidden="true"><span>DV<br/>HTB</span></div><button class="button secondary" data-load-spotify data-title="Spotify — Diễn Viên Hiện Trên Biển" data-loading={x.loading}>{x.load}</button><p class="micro">{x.spotifyNote}</p><p role="status" class="micro" data-spotify-status></p></div></div></section>}
{creative&&(home||page==='film')&&<section class="section film-section reveal"><div class="section-heading"><div><div class="eyebrow">02 / {u.film}</div><h2>{x.film[0]}</h2></div><p>{x.film[1]}</p></div><div class="film-study" role="group" aria-label={u.example}>{['sea','warm','night'].map((tone,i)=><div class="study-frame"><div class:list={['exposure',`exposure-${tone}`]} aria-hidden="true"/><span class="mono">0{i+1} / {x.frames[i][0]}</span><h3>{x.frames[i][1]}</h3><p>{x.frames[i][2]}</p></div>)}</div><p class="micro">{x.filmNote}</p></section>}
