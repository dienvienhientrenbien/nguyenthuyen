---
import copy from '../data/resilience.json';
const {lang='en',page='home'}=Astro.props;
const c=copy[lang],home=page==='home';
const notes=`${lang==='en'?'':'/'+lang}/notes/#recovery`;
---
<section class="section resilience-section reveal" id="resilience" aria-labelledby="resilience-heading">
 {home&&<div class="resilience-story"><div><div class="eyebrow">{c.label}</div><h2 id="resilience-heading" set:html={c.heading}/><p>{c.story}</p><a class="text-link" href={notes}>{c.read} ↗</a></div><div class="resilience-quote glass"><span class="mono">RESILIENCE FIRST</span><blockquote>{c.quote}</blockquote><p class="mono">{c.credit}</p><svg viewBox="0 0 260 96" aria-hidden="true"><path d="M12 65h66c22 0 22-38 45-38h25c20 0 20 38 40 38h60"/><path class="return-path" d="M12 65h33c35 0 24 22 62 22h33c35 0 34-22 66-22h42"/><circle cx="12" cy="65" r="4"/><circle cx="248" cy="65" r="4"/></svg></div></div>}
 {!home&&<div class="section-heading"><div><div class="eyebrow">RESILIENCE FIRST</div><h2 id="resilience-heading">{c.try}</h2></div></div>}
 <div class="resilience-lab glass" data-switcher>
  <div class="resilience-options" role="group" aria-label={c.try}>{c.scenarios.map((r,i)=><button type="button" data-choice={i} aria-controls={`resilience-${i}`} aria-pressed={i===0}><span class="mono" aria-hidden="true">0{i+1}</span>{r[0]}<span aria-hidden="true">↗</span></button>)}</div>
  <div class="resilience-panels" aria-live="polite" aria-atomic="true">{c.scenarios.map((r,i)=><article id={`resilience-${i}`} data-panel={i} hidden={i!==0}><h3>{r[1]}</h3><p>{r[2]}</p><p class="resilience-question">{r[3]}</p></article>)}</div>
  <div class="resilience-route"><span class="mono">{c.route}</span><ol>{c.stages.map((s,i)=><li><span class="route-node" aria-hidden="true">0{i+1}</span><span>{s}</span></li>)}</ol></div>
 </div>
</section>
