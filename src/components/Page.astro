---
import Layout from '../layouts/Layout.astro';
import HeroScene from './HeroScene.astro';
import Experience from './Experience.astro';
import Brief from './Brief.astro';
import data from '../data/content.json';
const { page='home', lang='en' } = Astro.props;
const d=data.pages[lang][page], u=data.ui[lang], brand=data.brand;
const personal=brand==='personal',creative=brand==='creative';
const {legal:brandName,email}=data.meta;
const local=(slug='')=>`${lang==='en'?'':'/'+lang}/${slug?slug+'/':''}`;
const other=(personal?'https://duncansystem.com':'https://nguyenthuyen.vn')+local();
const contact=data.contacts[lang][brand];
const description=d.description||`${d.title} — ${brandName}`;
---
<Layout title={`${d.title} — ${brandName}`} description={description} page={page} lang={lang} brand={brand}>
{page==='home' ? <>
 <section class="hero">
  <div><div class="eyebrow">{d.eyebrow}</div><h1 set:html={d.heading}/><p class="lead">{d.lead}</p><div class="hero-actions"><a class="button primary" href={creative?'https://open.spotify.com/artist/5SDr2lA0fFux0k4qYZYbAT':local('contact')}>{d.cta}<span class="arrow" aria-hidden="true">↗</span></a><a class="button secondary" href={local(creative?'film':personal?'about':'solutions')}>{d.secondary}<span aria-hidden="true">→</span></a></div><span class="micro">{d.micro}</span></div>
  <HeroScene brand={brand} u={u}/>
 </section>
 <div class="divider"><p>{d.divider}</p><div class="expertise">{d.expertise.map(x=><span>{x}</span>)}</div></div>
 </> : <section class="page-hero"><div class="eyebrow">{d.eyebrow}</div><h1 set:html={d.heading}/>{d.lead&&<p class="lead">{d.lead}</p>}</section>}

<Experience page={page} lang={lang}/>
{page==='contact'&&<Brief lang={lang}/>}

{page==='solutions'&&<><section class="section story"><div><div class="eyebrow">{d.roadmapLabel}</div><h2 set:html={d.roadmapHeading}/></div><div class="prose roadmap"><p>{d.roadmapText}</p><p><a href="https://leo.amazon.com/business/industries/maritime">{d.roadmapLink} ↗</a></p></div></section><p class="micro availability">{d.availability}</p></>}

{d.sections&&<div class="prose">{d.quote&&<blockquote>{d.quote}</blockquote>}{d.sections.map(([title,text])=><section><h2 class={page==='principles'?'mono':undefined}>{title}</h2><p>{text}</p></section>)}{d.closing&&<p class="quote-line">{d.closing}</p>}{personal&&page==='about'&&<p><a href={other}>DUNCAN SYSTEM LLC ↗</a></p>}</div>}

{d.facts&&<section class="section company-facts"><div class="section-heading"><div><div class="eyebrow">DUNCAN SYSTEM LLC</div><h2>{d.factsTitle}</h2></div><p>{d.factsNote}</p></div><dl>{d.facts.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}

{page==='404'&&<div class="error-action"><a class="button primary" href={local()}>{u.back}<span aria-hidden="true">→</span></a></div>}

{!['404','privacy','principles'].includes(page)&&<section class="contact-panel glass" aria-labelledby="contact-title"><div><div class="eyebrow">{contact[0]}</div><h2 id="contact-title" set:html={contact[1]}/><p>{contact[2]}</p></div><div class="contact-methods"><a href={`mailto:${email}`}>{email}<span>{u.email} ↗</span></a>{!creative&&<><a href="tel:+13079983948">+1 307 998 3948<span>{u.us} ↗</span></a><a href="tel:+84987123512">+84 987 123 512<span>{u.vn} ↗</span></a></>}</div></section>}
</Layout>
