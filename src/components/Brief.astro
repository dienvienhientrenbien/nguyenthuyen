---
import data from '../data/content.json';import experience from '../data/experience.json';
const {lang}=Astro.props,u=data.ui[lang],x=experience[lang];
---
<section class="section brief-section" id="project-brief"><div><div class="eyebrow">{u.contact}</div><h2>{u.brief}</h2><p>{u.briefLead}</p><p class="micro">{u.local}</p></div><form class="brief-form glass" data-brief data-email={data.meta.email} data-copied={u.copied} data-copy-fail={u.copyFail} data-subject={u.talk}><label for="brief-topic">{u.topic}</label><select id="brief-topic" name="topic">{x.topics.map(t=><option>{t}</option>)}</select><label for="brief-name">{u.name}</label><input id="brief-name" name="name" autocomplete="name" maxlength="100"/><label for="brief-context">{u.context}</label><textarea id="brief-context" name="context" required maxlength="1200" rows="5" placeholder={u.placeholder}/><button type="submit" class="button primary">{u.generate} ↗</button><div data-draft hidden><label for="brief-output">{u.draft}</label><textarea id="brief-output" rows="8"/><div class="draft-actions"><a data-mailto class="button primary">{u.send} ↗</a><button type="button" data-copy class="button secondary">{u.copy}</button></div><p role="status" data-copy-status/></div><noscript><p><a href={'mailto:'+data.meta.email}>{data.meta.email} ↗</a></p></noscript></form></section>
