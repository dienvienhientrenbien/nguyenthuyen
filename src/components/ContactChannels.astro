---
import contacts from '../data/contact-channels.json';
import data from '../data/content.json';
const {lang='en',inline=false}=Astro.props;
const u={vi:{title:'Nhắn cho Thuyên',artist:'Liên hệ DVHTB',intro:'Chọn nơi mình trò chuyện.',note:'Liên kết mở ứng dụng hoặc tab mới.',close:'Đóng',copy:'Sao chép ID',copied:'Đã sao chép ID WeChat.',manual:'Chọn ID bên dưới để sao chép.',hint:'Tìm ID này trong mục Thêm bạn của WeChat.'},en:{title:'Message Thuyên',artist:'Contact DVHTB',intro:'Choose where we talk.',note:'Links open the app or a new tab.',close:'Close',copy:'Copy ID',copied:'WeChat ID copied.',manual:'Select the ID below to copy it.',hint:'Find this ID in WeChat’s Add Contacts.'},zh:{title:'联系 Thuyên',artist:'联系 DVHTB',intro:'选择聊天方式。',note:'链接会打开应用或新标签页。',close:'关闭',copy:'复制微信号',copied:'微信号已复制。',manual:'请选择下方微信号并复制。',hint:'在微信“添加朋友”中搜索此微信号。'}}[lang];
const title=data.brand==='creative'?u.artist:u.title;
const channels=contacts.messaging,socials=contacts.socials;
---
{inline?<section class="contact-channel-inline"><h2>{title}</h2><p>{u.intro}</p><div class="channel-inline-links">
 {channels.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span>{c.name} ↗</span><small>{c.detail}</small></a>)}
 <div class="wechat-card" data-wechat><strong>{lang==='zh'?'微信':'WeChat'}</strong><code>{contacts.wechat}</code><button type="button" data-copy-wechat data-value={contacts.wechat} data-success={u.copied} data-failure={u.manual}>{u.copy}</button><small>{u.hint}</small><p class="wechat-status" role="status" data-wechat-status></p><input hidden readonly value={contacts.wechat} aria-label="WeChat ID" data-wechat-fallback/></div>
 {socials.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span>{c.name} ↗</span><small>{c.detail}</small></a>)}
 </div></section>:<aside class="contact-widget" aria-label={title}><details data-contact-widget><summary class="contact-widget-trigger glass"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 11a8 8 0 0 1-8 8H5l-4 3V11a9 9 0 0 1 19 0Z"/><path d="M6 10h9M6 14h6"/></svg><span>{title}</span></summary><div class="contact-widget-panel glass"><div class="contact-widget-head"><div><strong>{title}</strong><p>{u.intro}</p></div><button type="button" data-close-contact aria-label={u.close}>×</button></div><nav aria-label={title}>{channels.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer"><span class="channel-icon" aria-hidden="true">{c.icon}</span><span><strong>{c.name}</strong><small>{c.detail}</small></span><span aria-hidden="true">↗</span></a>)}</nav>
 <div class="wechat-row" data-wechat><div class="wechat-heading"><span class="channel-icon" aria-hidden="true">微</span><div><strong>{lang==='zh'?'微信':'WeChat'}</strong><code>{contacts.wechat}</code></div></div><button type="button" data-copy-wechat data-value={contacts.wechat} data-success={u.copied} data-failure={u.manual}>{u.copy}</button><small>{u.hint}</small><p class="wechat-status" role="status" data-wechat-status></p><input hidden readonly value={contacts.wechat} aria-label="WeChat ID" data-wechat-fallback/></div>
 <div class="contact-social">{socials.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name} ↗</a>)}</div><small>{u.note}</small></div></details></aside>}
