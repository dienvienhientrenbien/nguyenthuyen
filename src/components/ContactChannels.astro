---
const {lang='en',inline=false}=Astro.props;
const u={vi:{title:'Nhắn cho Thuyên',intro:'Chọn nơi mình trò chuyện.',note:'Mở ứng dụng hoặc tab mới.',social:'Kết nối',close:'Đóng'},en:{title:'Message Thuyên',intro:'Choose where we talk.',note:'Opens the app or a new tab.',social:'Connect',close:'Close'},zh:{title:'联系 Thuyên',intro:'选择聊天方式。',note:'打开应用或新标签页。',social:'社交主页',close:'关闭'}}[lang];
const channels=[['Zalo','+84 987 123 512','https://zalo.me/84987123512','Z'],['WhatsApp','+84 987 123 512','https://wa.me/84987123512','W'],['Messenger','Diễn Viên Hiện Trên Biển','https://m.me/dienvienhientrenbien','M']];
---
{inline?<section class="contact-channel-inline"><h2>{u.title}</h2><p>{u.intro}</p><div class="channel-inline-links">{channels.map(([name,detail,url,icon])=><a href={url} target="_blank" rel="noopener noreferrer"><span>{name} ↗</span><small>{detail}</small></a>)}<a href="https://www.linkedin.com/in/nguyendinhthuyen/" target="_blank" rel="noopener noreferrer"><span>LinkedIn ↗</span><small>Nguyễn Đình Thuyên</small></a><a href="https://www.facebook.com/dienvienhientrenbien" target="_blank" rel="noopener noreferrer"><span>Facebook ↗</span><small>Diễn Viên Hiện Trên Biển</small></a></div></section>:<aside class="contact-widget" aria-label={u.title}><details data-contact-widget><summary class="contact-widget-trigger glass"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 11a8 8 0 0 1-8 8H5l-4 3V11a9 9 0 0 1 19 0Z"/><path d="M6 10h9M6 14h6"/></svg><span>{u.title}</span></summary><div class="contact-widget-panel glass"><div class="contact-widget-head"><div><strong>{u.title}</strong><p>{u.intro}</p></div><button type="button" data-close-contact aria-label={u.close}>×</button></div><nav aria-label={u.title}>{channels.map(([name,detail,url,icon])=><a href={url} target="_blank" rel="noopener noreferrer"><span class="channel-icon" aria-hidden="true">{icon}</span><span><strong>{name}</strong><small>{detail}</small></span><span aria-hidden="true">↗</span></a>)}</nav><div class="contact-social"><a href="https://www.linkedin.com/in/nguyendinhthuyen/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.facebook.com/dienvienhientrenbien" target="_blank" rel="noopener noreferrer">Facebook ↗</a></div><small>{u.note}</small></div></details></aside>}
